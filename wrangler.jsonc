{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qulaghai",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9c9884b7-93ed-40fe-a5c2-3a353ba8e686","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "1c6c4f8cb743473682cce879cefc9f67" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
